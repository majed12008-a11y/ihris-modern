# iHRIS Backend Environment Configuration (example — no real secrets)
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://ihris:CHANGE_ME@localhost:5432/ihris_dev"

# JWT Configuration
JWT_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# bcrypt salt rounds
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN="http://localhost:5173"

# MySQL (legacy) connection for migration only
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=ihris_manage
