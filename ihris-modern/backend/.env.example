# iHRIS Backend Environment Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://ihris:ihris_password@localhost:5432/ihris_manage"

# JWT Configuration
JWT_SECRET="ihris-change-me-in-production-secret"
JWT_EXPIRES_IN="7d"

# bcrypt salt rounds
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN="http://localhost:5173"

# MySQL (legacy) connection for migration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3201
MYSQL_USER=ihris_manage
MYSQL_PASSWORD=New@20$$47
MYSQL_DATABASE=ihris_manage
