{
  "name": "ihris-backend",
  "version": "1.0.0",
  "description": "iHRIS Suite Modern Backend - Node.js + TypeScript + PostgreSQL",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node src/scripts/seed.ts",
    "migrate:mysql-to-pg": "ts-node src/scripts/mysql-to-postgres.ts",
    "test": "jest"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "arabic-persian-reshaper": "^1.0.1",
    "bcryptjs": "^2.4.3",
    "bidi-js": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.7.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.2",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.13.4",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
