# Production environment TEMPLATE — copy to .env.production on the server.
# This file contains placeholders only; never commit real credentials.
NODE_ENV=production
PORT=5000

# PostgreSQL — use a dedicated least-privilege application user.
DATABASE_URL="postgresql://ihris_app:CHANGE_ME@db-host:5432/ihris_manage"

# JWT — generate a long random value, unique per environment.
JWT_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"

BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN="https://ihris.example.org"

# Legacy MySQL connection (migration jobs only; leave empty in normal runtime).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
